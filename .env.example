# ==============================================================================
# Fetchz Root Environment Variables (Placeholder Reference)
# For service-specific configuration, refer to frontend/.env.example & backend/.env.example
# ==============================================================================

# Frontend (frontend/.env.local)
# The public backend API URL embedded at build time by Vite
VITE_API_URL=https://your-render-service.onrender.com

# Backend (backend/.env.local)
# Comma-separated frontend origins allowed to call the API in production
FRONTEND_ORIGIN=https://your-project.vercel.app

# Optional: self-hosted Cobalt instance
# COBALT_API_URL=https://your-cobalt.example

# Optional: custom binary paths when not using Docker
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
