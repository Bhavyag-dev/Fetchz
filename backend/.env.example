# Comma-separated frontend origins allowed to call this API in production.
FRONTEND_ORIGIN=https://your-project.vercel.app

# Optional: use a self-hosted Cobalt instance.
# COBALT_API_URL=https://your-cobalt.example

# Optional only when not using the included Dockerfile.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
